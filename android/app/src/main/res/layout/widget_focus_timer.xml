<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_card_bg"
    android:padding="0dp">

    <!-- Left accent focus strip -->
    <View
        android:id="@+id/widget_accent_strip"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:background="#0E5FC3" />

    <!-- Card Inner Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Badge & Timer -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- In Focus Badge -->
            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/widget_badge_bg"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="In Focus"
                android:textColor="#ACC7FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Remaining Time Display -->
            <TextView
                android:id="@+id/widget_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="⏱ 25:00"
                android:textColor="#C2C6D5"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Main Task Info & Check Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_task_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Deploy staging preview on Vercel"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_task_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Build hooks ready • DNS synced"
                    android:textColor="#8C909E"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Complete checkmark button -->
            <ImageView
                android:id="@+id/widget_btn_complete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_check_bg"
                android:padding="8dp"
                android:src="@drawable/ic_btn_check"
                android:contentDescription="Complete Task" />
        </LinearLayout>

        <!-- Action Pill Button -->
        <LinearLayout
            android:id="@+id/widget_btn_action"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_btn_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_btn_play"
                android:contentDescription="Action Icon" />

            <TextView
                android:id="@+id/widget_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Begin 25-Min Focus"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
